public class TestJava1 {
    public static boolean compareNames(String name1, String name2) {
        // BUG: In Java le stringhe si confrontano con .equals()
        // Questo codice restituirà false per due oggetti String diversi ma con lo stesso testo.
        if (name1 == null && name2 == null) {
            return true; // Entrambe le stringhe sono null, consideriamo le uguali
        }
        if (name1 == null || name2 == null) {
            return false; // Una è null e l'altra no, quindi sono diverse
        }
        return name1.equals(name2);
    }

    public static void main(String[] args) {
        String a = new String("Mario");
        String b = new String("Mario");
        System.out.println(compareNames(a, b)); // Dovrebbe stampare true
        String c = "Luigi";
        String d = "Luigi";
        System.out.println(compareNames(c, d)); // Dovrebbe stampare true
        String e = new String("Mario");
        String f = "Mario";
        System.out.println(compareNames(e, f)); // Dovrebbe stampare true
        System.out.println(compareNames(null, null)); // Dovrebbe stampare true
        System.out.println(compareNames("Mario", null)); // Dovrebbe stampare false
    }
}